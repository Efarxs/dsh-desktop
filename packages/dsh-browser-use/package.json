{
  "deepseekHarness": {
    "release": "dsh-v0.2.0-rc.2",
    "version": "0.2.0-rc.2"
  },
  "description": "deepseek-harness 的 codex 式浏览器操控插件：拉起用户本机的 Chrome/Edge（独立 profile），模型经 CDP 工具集实时操控，投屏画面进右侧边栏",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.1",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "browser-use",
    "cdp"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "name": "dsh-browser-use",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/clean-lib.mjs && tsc --emitDeclarationOnly --removeComments && tsc -p tsconfig.server.json && esbuild src/client/index.tsx --bundle --format=cjs --platform=browser --external:react --external:react-dom --external:react/jsx-runtime --jsx=automatic --outfile=lib/client.js --log-level=error && node scripts/wrap-client.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "check:client-bundle": "node scripts/verify-client-bundle.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build",
    "verify": "npm run check && npm run test && npm run build && npm run check:client-bundle && npm run verify:package",
    "test": "vitest run"
  },
  "type": "module",
  "types": "lib/types/index.d.ts",
  "version": "0.1.0",
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "src/",
    "!src/client/CLIENT_CONTRACT.md"
  ]
}
